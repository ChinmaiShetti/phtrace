# Copy this file to .env and set PG_ADMIN_PASSWORD (your local "postgres" superuser password).
# Everything else can stay as it is for local development.

PG_HOST=localhost
PG_PORT=5432
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=CHANGE_ME

# Database and the two roles that reset_db.py creates
DB_NAME=pharmatrace
PG_OWNER_PASSWORD=owner_dev_password
PG_APP_PASSWORD=app_dev_password

# Backend
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173
